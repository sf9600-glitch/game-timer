{
  "terminal.integrated.defaultLocation": "view",
  "terminal.integrated.hideOnStartup": "never",
  "workbench.panel.defaultLocation": "bottom",
  "workbench.panel.opensMaximized": "never",
  "workbench.statusBar.visible": true,
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,
  "runOnSave.statusMessageTimeout": 15000,
  "runOnSave.commands": [
    {
      "match": "(index\\.html|css/app\\.css|js/app\\.js|locales/.+\\.json|tutorial-en\\.md|新手教學\\.md)$",
      "command": "bash \"${workspaceFolder}/scripts/deploy.sh\"",
      "runIn": "backend",
      "async": false,
      "clearOutput": false,
      "runningStatusMessage": "正在上傳到 GitHub…",
      "finishStatusMessage": "✅ 已完成上傳"
    }
  ]
}
