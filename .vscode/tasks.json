{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "自動部署監聽（存檔就部署）",
      "type": "shell",
      "command": "bash scripts/watch-deploy.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false,
        "showReuseMessage": false,
        "clear": false,
        "echo": true
      },
      "problemMatcher": []
    },
    {
      "label": "立即部署一次",
      "type": "shell",
      "command": "bash scripts/deploy.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": false,
        "showReuseMessage": false,
        "clear": false,
        "echo": true
      },
      "problemMatcher": []
    }
  ]
}
